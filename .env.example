# ---------------------------------------------------------------------------
# MongoDB
#
# MUST be a replica set. Every write path in this service - accepting an order,
# reserving stock, releasing it - uses a multi-document transaction, and
# MongoDB only supports transactions on a replica set. A single node is enough:
#
#   mongod --replSet rs0 --dbpath /your/data/path
#   mongosh --eval 'rs.initiate()'
#   mongosh --eval 'rs.status()'      # confirm before starting the app
#
# directConnection=true stops the driver trying to discover other members.
# The app checks this at boot and refuses to start with a clear message rather
# than failing cryptically on the first request.
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/canals?replicaSet=rs0&directConnection=true

# Redis, used by BullMQ for the saga queue.
REDIS_URI=redis://127.0.0.1:6379

PORT=4000

# Where each outbound integration lives. Required: Payment, Customers,
# Geocoding and Catalog know nothing of each other or of "mockdata" - each
# just calls its own base URL, with no built-in default. Pointed at
# http://127.0.0.1:PORT (as below) they are handled by this same app's
# mockdata module, which answers all four locally. Override one independently
# to point that integration at a real provider (or a mockdata instance running
# elsewhere) without touching the others. Mockdata's management endpoints -
# add/list/remove warehouses, customers, addresses, credit-card states,
# products - live on this same port regardless (/warehouses, /customers,
# /addresses, /credit-cards, /products), reachable while the app is running.
PSP_BASE_URL=http://127.0.0.1:4000/psp
CUSTOMER_BASE_URL=http://127.0.0.1:4000/customers
GEOCODING_BASE_URL=http://127.0.0.1:4000/addresses
CATALOG_BASE_URL=http://127.0.0.1:4000/products

# ---------------------------------------------------------------------------
# Outbox relay - moves committed order events onto the queue.
# ---------------------------------------------------------------------------
ORDER_OUTBOX_POLL_INTERVAL_MS=1000
ORDER_OUTBOX_BATCH_SIZE=100
# How long a relay's claim on an event is held before another relay may retry
# it. Covers a relay process dying mid-dispatch.
ORDER_OUTBOX_CLAIM_TIMEOUT_MS=30000
# After this many failed dispatch attempts an event is marked FAILED and left
# for an operator. Alert on it: no worker will ever see that event.
ORDER_OUTBOX_MAX_ATTEMPTS=10
ORDER_OUTBOX_ENABLED=true

# ---------------------------------------------------------------------------
# Saga worker
#
# Set ORDER_SAGA_WORKER_ENABLED=false to run a process as API-only, so API and
# worker instances can scale independently off the same image.
# ---------------------------------------------------------------------------
ORDER_SAGA_CONCURRENCY=5
ORDER_SAGA_ATTEMPTS=5
ORDER_SAGA_BACKOFF_MS=1000
ORDER_SAGA_WORKER_ENABLED=true

# ---------------------------------------------------------------------------
# Reconciliation sweeper (runs every 30s)
# ---------------------------------------------------------------------------
# How long an order may sit in a non-terminal state before the sweeper treats
# it as stranded. This is also the deadline after which a still-PENDING order
# is failed, so it MUST stay comfortably above the worker's total retry budget
# (ORDER_SAGA_ATTEMPTS x exponential ORDER_SAGA_BACKOFF_MS ~= 31s by default).
# Set it too low and a queue backlog will fail orders nothing is wrong with.
ORDER_STALE_AFTER_MS=300000
# How long one instance's claim on reconciling an order is held.
ORDER_SWEEP_LEASE_MS=60000
ORDER_SWEEP_BATCH_SIZE=50
ORDER_SWEEPER_ENABLED=true

# ---------------------------------------------------------------------------
# Mock PSP fault injection (read by the mockdata module) - for demonstrating
# the saga and sweeper. All default to 0, i.e. a perfectly reliable gateway.
# For deterministic per-card outcomes instead of randomness, pin a card number
# via POST /credit-cards - it overrides PAYMENT_FAILURE_RATE for that
# card only.
# ---------------------------------------------------------------------------
PAYMENT_LATENCY_MS=0
# Probability [0..1] that a charge is declined.
PAYMENT_FAILURE_RATE=0
# Probability [0..1] that the charge is recorded but the response is lost.
# This is the scenario the reconciliation sweeper exists to resolve; set it to
# 1 and watch a stuck order get recovered rather than wrongly refunded.
PAYMENT_LOST_RESPONSE_RATE=0
